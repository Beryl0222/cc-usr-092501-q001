{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "返还文物入藏责任链领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "HANDOVER_RECORDED",
        "CONDITION_ASSESSED",
        "CUSTODY_TRANSFERRED",
        "ACCESSION_DECIDED",
        "CATALOG_RELEASED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "returned_object",
        "custody_lot",
        "condition_report",
        "catalog_release"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
