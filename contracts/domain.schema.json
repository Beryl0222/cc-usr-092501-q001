{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "返还文物入藏责任链领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "actor",
    "summary",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "BATCH_REGISTERED",
        "SEAL_RECEIPT_RECORDED",
        "SEAL_RECEIPT_QUARANTINED",
        "SEAL_RECEIPT_RESOLVED",
        "OBJECT_HANDED_OVER",
        "MATERIAL_TESTED",
        "DISEASE_REPORTED",
        "OBJECT_FROZEN",
        "OBJECT_UNFROZEN",
        "APPLICATION_HELD",
        "APPLICATION_RESUMED",
        "PROVENANCE_RECORDED",
        "DISPUTE_RECORDED",
        "DISPUTE_CLEARED",
        "RESTRICTION_RECORDED",
        "RESTRICTION_LIFTED",
        "CUSTODY_TRANSFERRED",
        "APPLICATION_SUBMITTED",
        "APPLICATION_APPROVED",
        "APPLICATION_REJECTED",
        "ACCESSION_DECIDED",
        "ACCESSION_REVOKED",
        "CATALOG_RELEASED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "return_batch",
        "returned_object",
        "application",
        "catalog_release"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "同一聚合内单调递增的事件版本"
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "description": "事件责任人（入藏批准、撤销等前后责任据此追溯）"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object"
    },
    "causation_id": {
      "type": ["string", "null"],
      "description": "触发本事件的上游事件（如病害报告触发冻结）"
    }
  },
  "additionalProperties": false
}
